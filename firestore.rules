rules_version = '2';

// ============================================================
// MyGameON Hub — Firestore Security Rules
// 
// Updated: 26 April 2026 — Phase 0 (Detail Page Foundation)
// 
// Changes from previous version:
// - Added: gamesPrivate/ (admin-only, separated from games/)
// - Added: metadata/{type}/entries/{id} (public read, admin write)
// - Updated: games/ read rule (filter isProblematic + availabilityStatus)
// - Removed: genres/ (migrated to metadata/genres/entries/)
// - Cleaned: isAdmin() now uses single 'role' custom claim
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // HELPER FUNCTIONS
    // ========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Single source of truth: role-based check
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isMember() {
      return isSignedIn() && request.auth.token.role == 'member';
    }

    // For public Detail Page access — filter out problematic/unavailable games
    function isPubliclyVisibleGame() {
      return resource.data.isProblematic == false 
             && resource.data.availabilityStatus != 'unavailable';
    }

    function isValidTrackingCode() {
      return request.resource.data.trackingCode is string &&
        request.resource.data.trackingCode.matches('^RQ-[A-Z0-9]{6}$');
    }

    // Public request create — sensitive fields (contactWhatsApp, shopeeUsername)
    // are now written to /requests/{id}/private/contact instead
    function isPublicRequestCreate() {
      return request.resource.data.keys().hasOnly([
          'title',
          'title_lower',
          'platform',
          'notes',
          'status',
          'trackingCode',
          'votes',
          'createdAt',
          'updatedAt'
      ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.title_lower is string &&
        request.resource.data.platform == 'PC' &&
        request.resource.data.notes is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.votes == 1 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        isValidTrackingCode();
    }

    // Public update for vote increment only
    function isPublicVoteUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'updatedAt']) &&
        request.resource.data.votes is number &&
        resource.data.votes is number &&
        request.resource.data.votes == resource.data.votes + 1 &&
        request.resource.data.updatedAt is timestamp;
    }

    // ========================================================
    // PUBLIC COLLECTIONS — games & requests
    // ========================================================

    // Games:
    // - Public: read kalau not problematic and available
    // - Admin: read all (preview), write all
    match /games/{gameId} {
      allow read: if isAdmin() || isPubliclyVisibleGame();
      allow write: if isAdmin();
    }

    // Requests: public fields only (NO sensitive contact data)
    // contactWhatsApp & shopeeUsername → /requests/{id}/private/contact
    match /requests/{reqId} {
      allow create: if isAdmin() || isPublicRequestCreate();
      allow read: if true;
      allow update: if isAdmin() || isPublicVoteUpdate();
      allow delete: if isAdmin();

      // Private sub-collection: sensitive contact info (admin-only read)
      match /private/{docId} {
        allow read, write: if isAdmin();
        // Public can create 'contact' doc at submission time only
        allow create: if docId == 'contact' &&
          request.resource.data.keys().hasOnly(['contactWhatsApp', 'shopeeUsername']) &&
          request.resource.data.contactWhatsApp is string &&
          request.resource.data.contactWhatsApp.size() >= 9 &&
          request.resource.data.contactWhatsApp.size() <= 20 &&
          request.resource.data.shopeeUsername is string &&
          request.resource.data.shopeeUsername.size() > 0;
      }
    }

    // ========================================================
    // DIRECT ORDERS (Web QRIS Direct Checkout - Hardened)
    // ========================================================
    match /direct_orders/{orderId} {
      // Allow public creation of direct orders with hardened validation
      allow create: if request.resource.data.invoiceId is string &&
        request.resource.data.invoiceId.matches('^MGO-[A-Z0-9-]+$') &&
        request.resource.data.buyerName is string &&
        request.resource.data.buyerName.size() >= 2 &&
        request.resource.data.buyerName.size() <= 80 &&
        request.resource.data.buyerEmail is string &&
        request.resource.data.buyerEmail.size() <= 100 &&
        request.resource.data.buyerEmail.matches('^[^@]+@[^@]+\\.[^@]+$') &&
        request.resource.data.buyerPhone is string &&
        request.resource.data.buyerPhone.size() >= 8 &&
        request.resource.data.buyerPhone.size() <= 25 &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount > 0 &&
        request.resource.data.totalAmount <= 50000000 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 30 &&
        request.resource.data.status == 'pending_verification' &&
        request.resource.data.createdAt is timestamp;

      // Only signed-in admins can read, update, or delete direct orders
      allow read, update, delete: if isAdmin();
    }

    // ========================================================
    // ADMIN-ONLY: gamesPrivate (NEW — Phase 0)
    // ========================================================

    match /gamesPrivate/{gameId} {
      allow read, write: if isAdmin();
    }

    // ========================================================
    // METADATA: genres, tags, playModes, platforms (NEW — Phase 0)
    // ========================================================
    // Public can read for displaying labels in UI
    // Only admin can write to maintain consistency

    match /metadata/{type}/entries/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // CONTENT: tutorials, downloads, prerequisites, blogs
    // ========================================================

    match /tutorials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prerequisites/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Winning Product: single-doc spotlight on landing page
    match /winningProduct/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================
    // FAQ & USER QUESTIONS
    // ========================================================

    // FAQs: public can read active items, admin manages all
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User questions: public can submit (validated shape only), admin manages.
    // Hardened: enforce exact field set + types + size limits to block
    // arbitrary/oversized payloads and spam injection.
    function isPublicQuestionCreate() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'question', 'status',
          'answer', 'promotedToFaq', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 120 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.question is string &&
        request.resource.data.question.size() >= 5 &&
        request.resource.data.question.size() <= 1000 &&
        request.resource.data.status == 'new' &&
        request.resource.data.answer == null &&
        request.resource.data.promotedToFaq == false &&
        request.resource.data.createdAt is timestamp;
    }

    match /userQuestions/{qId} {
      allow create: if isAdmin() || isPublicQuestionCreate();
      allow read, update, delete: if isAdmin();
    }

    // ========================================================
    // ORDERS — purchase orders from desktop app (QRIS flow)
    // ========================================================

    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.gameId is string &&
        request.resource.data.buyerEmail is string &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // ========================================================
    // CLAIMS — Shopee customer order claims from /claim
    // ========================================================

    match /claims/{claimId} {
      allow create: if request.resource.data.invoice is string &&
        request.resource.data.invoice.size() >= 5 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read: if isAdmin() || 
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // ========================================================
    // SHOPEE ORDERS — Synced from Shopee emails / n8n
    // ========================================================

    match /shopee_orders/{invoice} {
      // Public can only get their single specific invoice doc in /claim (anti-crawler dump)
      allow get: if true;
      allow list: if isAdmin();
      // Admin / service account can create or manage
      allow create, delete: if isAdmin();
      // Client can update status to 'claimed' only when previously 'ready' or 'unclaimed'
      allow update: if isAdmin() || (
        (resource.data.status == 'ready' || resource.data.status == 'unclaimed') &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByEmail', 'claimedAt', 'claimedUid'])
      );
    }

    // ========================================================
    // FAILED CLAIM ATTEMPTS — Security & Anti-Bruteforce audit
    // ========================================================

    match /failed_claim_attempts/{attemptId} {
      allow create: if request.resource.data.invoice is string &&
        request.resource.data.timestamp is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // ========================================================
    // ADMIN / OPERATIONAL COLLECTIONS (preserved from existing)
    // ========================================================

    // NOTE: genres/ removed — migrated to metadata/genres/entries/

    match /emailLocations/{locId} {
      allow read, write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // Operational tracking — current names
    match /adminShifts/{shiftId} {
      allow read, write: if isAdmin();
    }

    match /dailyRevenues/{revId} {
      allow read, write: if isAdmin();
    }

    match /shopeeAnalytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /operational_daily_recap/{docId} {
      allow read, write: if isAdmin();
    }

    // Legacy names — preserved for backward compatibility
    match /shifts/{shiftId} {
      allow read, write: if isAdmin();
    }

    match /daily_revenues/{dateId} {
      allow read, write: if isAdmin();
    }

    // Helper for Joki AFK Roblox Admin validation
    function isJokiAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'madlighifari29@gmail.com' ||
        request.auth.token.email == 'madlighifari@gmail.com' ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/joki_admin_emails/$(request.auth.token.email)))
      );
    }

    // ========================================================
    // JOKI AFK ROBLOX (MULTI-TENANT WORKSPACES)
    // ========================================================
    // Public can read to view live queue & status countdown
    // Only admin can create, update, or delete

    match /joki_admin_emails/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isJokiAdmin();
    }

    match /joki_workspaces/{workspaceId} {
      allow read: if true;
      allow write: if isJokiAdmin();

      match /customers/{customerId} {
        allow read: if true;
        allow write: if isJokiAdmin();
      }

      match /queue/{queueId} {
        allow read: if true;
        allow write: if isJokiAdmin();
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isJokiAdmin();
      }
    }

    // Legacy fallback for backward compatibility (blocked from bulk dump)
    match /joki_customers/{customerId} {
      allow get: if true;
      allow list: if isJokiAdmin();
      allow write: if isJokiAdmin();
    }

    match /joki_queue/{queueId} {
      allow read: if true;
      allow write: if isJokiAdmin();
    }

    match /joki_settings/{settingId} {
      allow read: if true;
      allow write: if isJokiAdmin();
    }

    // ========================================================
    // CONFIG (NEW — for future Google login flow)
    // ========================================================
    // Stores admin email whitelist — referenced by auth Cloud Function

    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // ========================================================
    // USER-SCOPED DATA
    // ========================================================

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User activity log (for future audit trail)
    match /userActivityLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // ========================================================
    // DEFAULT DENY
    // ========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
