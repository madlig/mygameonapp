# ── Firebase Configuration (Public Client) ──
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── MyGameON Hub Backend Integration ──
# In local dev with Vite proxy or in Vercel with rewrites, leave empty to use relative '/api'
VITE_HUB_API_URL=/api

# ── n8n Workflow Automation ──
# Webhook URL from your n8n instance for self-claim order processing
VITE_N8N_CLAIM_WEBHOOK=https://your-n8n-instance.com/webhook/claim-order
# Optional telemetry webhook for error alerting
VITE_N8N_TELEMETRY_WEBHOOK=

# ── External Business Links ──
VITE_WHATSAPP_NUMBER=6285121309829
VITE_SHOPEE_STORE_URL=https://shopee.co.id/mygameon
